#!/bin/sh
#
# Shared postinstall for the deb and the rpm. Its jobs: make sure the `puppet`
# account exists and owns what it must, and make sure systemd knows about the
# units. Then, per format: on the deb, render /etc/default/openvox-ca from
# debconf through ucf, and enable and start the service (openvox-ca#251); on
# rpm's first install, apply the preset and say what to run next
# (openvox-ca#252).
#
# It is shared rather than per-format because the two formats install the same
# units, the same binaries and the same /etc/openvox-ca/config.yaml. What does
# differ between them is selected by the argument contract this script is
# called under -- dpkg's `configure` against rpm's install count -- in the
# cases below, rather than by two scripts.

set -eu

# The two paths this script hands to `puppet`. Overridable from the
# environment for the same reason SYSTEMD_RUNTIME below is: without it the
# ownership and permission branch is unreachable outside a container, and the
# hardening it applies -- --no-dereference, the symlink refusal, mode 0640 on a
# file that can hold credentials -- would go untested. Nothing in the packages
# sets either. OPENVOX_CA_CONFIG is also the variable the server reads its
# configuration file from, so whatever sets it -- a drop-in, or a root shell
# that exported it -- points this script at the file the service will read,
# which is the one it has to secure.
SSLDIR="${OPENVOX_CA_SSLDIR:-/etc/puppetlabs/puppet/ssl}"
CONFIG="${OPENVOX_CA_CONFIG:-/etc/openvox-ca/config.yaml}"

# The account the ssl-root check below compares owners against. Overridable for
# the same reason and with the same caveat as the two above: a spec runs as an
# ordinary user and cannot create files owned by `puppet`, so without it the
# branch that decides whether the ssl root is ours to take is reachable only in
# a container. It changes what the check COMPARES, never what is chowned --
# the chown below names puppet:puppet literally.
SSL_OWNER="${OPENVOX_CA_SSL_OWNER:-puppet}"

# Records that this package has enabled the provisioning oneshot at least once.
# See the enable block at the foot of this file for why the alternative --
# inferring it from dpkg's $2 -- gets a remove-then-reinstall wrong.
STATEDIR="${OPENVOX_CA_STATEDIR:-/var/lib/openvox-ca}"
ENABLED_MARKER="$STATEDIR/first-boot-enabled"

# Where systemd's runtime directory lives. Overridable from the environment for
# the same reason first-boot's roots are, and with the same caveat: nothing in
# the packages sets it, and neither dpkg nor rpm passes an environment, so an
# installed system always takes the default. It exists so a test can assert
# what this script does on a machine that has no systemd -- without it the
# systemd branch is unreachable off a Linux host, and a table asserting "acts
# on a removal, not on an upgrade" could only ever check the second half.
#
# The line below is repeated in all three maintainer scripts rather than
# sourced from a shared file, and that duplication is deliberate. A maintainer
# script has to be self-contained: postrm in particular runs at moments when
# this package's files are partly or wholly gone, so sourcing anything the
# package ships would make removal depend on the very files being removed. One
# assignment repeated three times is cheaper than that failure. This comment is
# the canonical explanation; the other two point here.
SYSTEMD_RUNTIME="${OPENVOX_CA_SYSTEMD_RUNTIME:-/run/systemd/system}"


# Failures here are reported and not fatal. Reported, because the previous
# version sent every one of them to /dev/null: a package could install
# "successfully" and leave a service that cannot read its own configuration,
# with nothing anywhere saying why. Not fatal, because a maintainer script
# that exits non-zero leaves the package half-configured, which is a worse
# state to hand an operator than a working install with a loud warning.
warn() {
	echo "openvox-ca: WARNING: $*" >&2
}

# dpkg passes "configure" on install and upgrade; rpm passes the number of
# packages that will remain, 1 on install and 2 on upgrade. Anything else --
# dpkg's abort-upgrade, abort-remove and friends -- is a rollback, where
# re-running this would fight the very state being rolled back to.
case "${1:-configure}" in
configure | 1 | 2) ;;
*) exit 0 ;;
esac

# -- debconf (deb) -----------------------------------------------------------

# The deb asks openvox-ca/ca-name in its config script (debian-config) and
# renders the answer below. Loading the confmodule re-executes this script
# under debconf's frontend, so it has to come before anything that has an
# effect: everything above is assignments, a function and the argument check.
# Once loaded it moves stdout onto stderr, so nothing this script prints can be
# misread as a debconf command. Not on the rpm, whose arguments are numbers.
#
# Overridable for the reason the other paths are: a spec supplies a stand-in.
# `set +u` around it: the confmodule is debconf's code, not written for -u.
CONFMODULE="${OPENVOX_CA_CONFMODULE:-/usr/share/debconf/confmodule}"
DEFAULT_FILE="${OPENVOX_CA_DEFAULT_FILE:-/etc/default/openvox-ca}"
DROPIN_ROOT="${OPENVOX_CA_DROPIN_ROOT:-/etc/systemd/system}"
VENDOR_UNIT_ROOT="${OPENVOX_CA_VENDOR_UNIT_ROOT:-/usr/lib/systemd/system}"
# Where a host that has not merged /usr keeps packaged units, and OpenVox
# Server 6+'s own CA directory: both only looked at for a takeover, below.
LEGACY_UNIT_ROOT="${OPENVOX_CA_LEGACY_UNIT_ROOT:-/lib/systemd/system}"
SERVER_CADIR="${OPENVOX_CA_SERVER_CADIR:-/etc/puppetlabs/puppetserver/ca}"
debconf=no
if [ "${1:-}" = configure ] && [ -r "$CONFMODULE" ]; then
	set +u
	# shellcheck disable=SC1090 # the confmodule is debconf's, not ours
	. "$CONFMODULE"
	set -u
	debconf=yes
fi

# -- The service account -----------------------------------------------------

# sysusers.d is the declarative answer and the one we ship. It is not enough on
# its own: rpm distributions wire a file trigger for /usr/lib/sysusers.d and
# Debian's does not reliably, so a package that only dropped the file would
# create no account on some hosts and the units would fail to start with a
# message about an unknown user. Calling systemd-sysusers directly makes the
# declaration authoritative on both; the useradd path is for hosts with no
# systemd-sysusers at all.
#
# Every branch is idempotent: systemd-sysusers leaves an existing account
# alone, and the fallback creates nothing it already found. That matters on
# upgrade, and it matters on a host where openvox-server got here first -- its
# account is the one we want, not one to correct.
#
# Reported rather than fatal, like everything else in this script. This block
# was the one exception, and `set -e` made a failure here abort the postinstall
# *before* the ownership fixes below -- so a host where the account already
# existed but sysusers exited non-zero for an unrelated reason (a read-only
# /etc in an image build, an account visible through NSS but absent from
# /etc/passwd, an exhausted system UID range) ended up with a configuration
# file the service still could not read. Warning and continuing leaves strictly
# more working than aborting does.
if command -v systemd-sysusers >/dev/null 2>&1; then
	systemd-sysusers /usr/lib/sysusers.d/openvox-ca.conf || warn \
		"systemd-sysusers could not create the \`puppet\` account from" \
		"/usr/lib/sysusers.d/openvox-ca.conf. openvox-ca.service and" \
		"openvox-ca-first-boot.service both run as that account and will not start until it exists."
else
	if ! getent group puppet >/dev/null 2>&1; then
		groupadd --system puppet || warn "could not create the \`puppet\` group."
	fi
	if ! getent passwd puppet >/dev/null 2>&1; then
		# Kept in step with packaging/sysusers/openvox-ca.conf: the home
		# directory and shell here must match the declarative form, or a host
		# without systemd-sysusers gets a different account from one with it.
		# magefile_test.go asserts the two agree.
		useradd --system --gid puppet \
			--home-dir /etc/puppetlabs/puppet \
			--shell /usr/sbin/nologin \
			--comment "OpenVox Certificate Authority" \
			puppet || warn "could not create the \`puppet\` account."
	fi
fi

# The two directories the package ships under the ssl tree are handed to
# `puppet` here, because at the moment dpkg unpacks them the account may not
# exist yet -- it is created above, in this script. (The rpm creates it earlier,
# in its preinstall, and declares the CA directory puppet-owned in the package
# itself; see packaging/nfpm.yaml. On the rpm this is a fallback.)
#
# --no-dereference: this runs as root over directories `puppet` may be able to
# write, and a symlink planted at one of these paths would otherwise have chown
# follow it and change the owner of whatever it points at.
#
# Not recursive: an existing tree may hold an agent's or a server's files, and
# this package is not entitled to reassign those.
if [ -d "$SSLDIR" ]; then
	# The CA directory, always. It is the one path the service writes, and the
	# only thing in it is the CA's own.
	ssl_dirs="$SSLDIR/ca"

	# The ssl root, only when everything already in it is `puppet`'s.
	#
	# Owning a directory is owning the right to rename what is in it, and
	# rename(2) within one parent checks write permission on the PARENT only.
	# So `puppet` owning $SSLDIR can move a root-owned certs/ aside, create its
	# own, and plant certs/ca.pem -- the trust anchor a root-running agent
	# verifies against -- without ever being able to write inside the original.
	# That was demonstrated, not inferred: as `puppet`, writing certs/ca.pem is
	# refused, and `mv certs certs.old && mkdir certs` then succeeds. Leaving
	# certs/ itself alone protects nothing while its parent changes hands.
	#
	# Hence the test: anything in the ssl root that `puppet` does not already
	# own belongs to something else -- on the host that matters, an agent that
	# runs as root -- and the root is left as it is. The cases that pass:
	#
	#   a fresh host       nothing there but ca/, so nothing to protect
	#   this CA's own host first-boot runs as `puppet`, so all it made is ours;
	#                      this is also what restores the root after an rpm
	#                      upgrade, which re-applies the packaged root:root
	#   OpenVox Server     its postinst already gave the whole tree to `puppet`
	#
	# Where it is left alone, provisioning stops at ensure_ssl_tree's
	# writability check and names the chown to run -- the operator's decision,
	# taken knowing what it grants, and not a package's to take as root.
	#
	# A find that fails -- the account does not exist because the block above
	# could not create it, say -- counts as "not ours". The check fails closed:
	# an unanswered question is not a yes.
	if foreign=$(find "$SSLDIR" -mindepth 1 -maxdepth 1 ! -name ca ! -user "$SSL_OWNER" -print 2>/dev/null); then
		if [ -z "$foreign" ]; then
			ssl_dirs="$SSLDIR $ssl_dirs"
		else
			warn "leaving $SSLDIR as it is: it holds entries that \`puppet\` does not own" \
				"($(printf '%s\n' "$foreign" | head -n 3 | tr '\n' ' ' | sed 's/ $//')), so something else -- most" \
				"likely openvox-agent -- uses it. Owning it would let \`puppet\` replace certs/ca.pem." \
				"Provisioning will stop and say what to do if it needs to write there."
		fi
	else
		warn "could not check who owns the entries in $SSLDIR, so leaving it as it is." \
			"Provisioning will stop and say what to do if it needs to write there."
	fi

	# shellcheck disable=SC2086 # deliberately word-split: the list is built
	# from literals above, never from operator input.
	chown --no-dereference puppet:puppet $ssl_dirs || warn \
		"could not give $ssl_dirs to puppet:puppet. The service and provisioning both run as" \
		"\`puppet\` and will not be able to write there; fix the ownership and run" \
		"'systemctl restart openvox-ca-first-boot'."
fi

# The configuration file is 0640 and can hold credentials, so the service must
# be able to read it and nothing else should. Without this it stays root:root
# and openvox-ca -- which runs as `puppet` -- cannot read its own
# configuration, including the cadir it refuses to start without.
#
# The symlink check comes first and is not decoration. `chown` has
# --no-dereference, so it was already safe; `chmod` has no portable
# equivalent -- GNU chmod grew -h only recently, and it is rejected outright by
# coreutils 8.32 (RHEL and Rocky 9) and 9.1 (Debian bookworm), two of the
# platforms these packages exist for. Using it there would fail, be swallowed
# by the `|| warn` below, and leave the mode unset altogether: worse than the
# hole it was meant to close. `[ -L ]` is POSIX and works everywhere.
#
# -L before -f, because -f follows the link and a symlink to a regular file
# would otherwise pass it.
if [ -L "$CONFIG" ]; then
	warn "$CONFIG is a symlink, so this package will not change its owner or mode --" \
		"both would apply to whatever it points at, which is not ours to alter. If that link is" \
		"deliberate, give its target root:puppet and mode 0640 yourself; openvox-ca runs as" \
		"\`puppet\` and must be able to read it."
elif [ -f "$CONFIG" ]; then
	chown --no-dereference root:puppet "$CONFIG" || warn \
		"could not give $CONFIG to root:puppet. openvox-ca runs as \`puppet\` and will not be able to" \
		"read its own configuration, including the cadir it refuses to start without."
	chmod 0640 "$CONFIG" || warn "could not set mode 0640 on $CONFIG; it may be readable by others."
fi

# -- Install-time values (deb) ----------------------------------------------

# The deb's counterpart of the EL package's /etc/sysconfig/openvox-ca: the same
# two variables, but rendered here from the debconf answer and handed to ucf,
# which keeps the operator's edits and, when the rendering has changed too,
# asks -- offering a three-way merge, which --three-way enables by keeping the
# previous rendering. Non-interactively it keeps theirs and leaves ours as
# .ucf-dist. Rendered at every configure, never at runtime: ucf tracks the file
# by checksum, so a runtime writer would be recorded as operator drift and
# prompt on the next upgrade about a change the package itself made. Not a
# dpkg conffile, and not in the package at all -- two managers on one path is
# the bug this avoids (openvox-ca#251).
#
# The same rule as EL's record-environment for what is left out, kept in step
# with it by hand: a value the operator has already chosen.
# OPENVOX_CA_CERTNAME when a drop-in for the oneshot mentions it;
# OPENVOX_CA_PUPPET_SERVER when config.yaml sets puppet_server or
# puppet_server_file, or a drop-in for the service mentions the list, its file
# or its configuration file. Re-checked at every configure, so an operator who
# later moves the list into config.yaml sees the line go on the next upgrade.

# dropins_mention succeeds when any drop-in systemd would apply to the unit
# mentions any of the named variables outside a comment: the unit's own <unit>.d,
# its prefix directories (openvox-.service.d and the like) and service.d, under
# /etc, /run and the vendor tree. Read from the files rather than asked of
# systemd, because this runs before the daemon-reload below -- systemd has not
# seen an operator's pre-placed drop-in yet on a first install -- and in
# chroots and image builds where there is no systemd to ask. The files are
# root's.
#
# A mention, not a parse, on purpose: it fails closed. systemd accepts quoted,
# single-quoted, continued and tab-separated assignments, an EnvironmentFile=
# whose file sets the variable, and more; any parser of those here would be one
# more place to disagree with systemd, and every disagreement would record an
# admin grant over a list the operator chose. A false match costs only a line
# the operator can add.
dropins_mention() {
	unit=$1
	shift
	for root in "$DROPIN_ROOT" "$SYSTEMD_RUNTIME" "$VENDOR_UNIT_ROOT"; do
		for f in "$root/$unit.d"/*.conf "$root"/openvox-*.service.d/*.conf "$root/service.d"/*.conf; do
			[ -f "$f" ] || continue
			for var in "$@"; do
				if sed -e '/^[[:space:]]*[#;]/d' "$f" | grep -q -- "$var"; then
					return 0
				fi
			done
		done
	done
	return 1
}

render_default_file() {
	db_get openvox-ca/ca-name || RET=
	name=$RET
	# The config script refuses an unusable name; checked again here, because
	# a preseeded answer reaches this script without passing through it, and
	# the value is written into a file systemd parses as KEY=VALUE.
	case "$name" in
	"" | -* | . | .. | ca | openvox-ca-server) name= ;;
	*[!A-Za-z0-9._-]*) name= ;;
	esac
	if [ -z "$name" ] && [ -n "$RET" ]; then
		# Non-printing characters shown as `?`, so a newline in the refused
		# value cannot forge a second line of output.
		warn "ignoring openvox-ca/ca-name \"$(printf '%s' "$RET" | tr -c '[:print:]' '?')\": not a" \
			"usable certificate name. Provisioning will choose the name; to set one, run" \
			"'dpkg-reconfigure openvox-ca'."
	fi

	record_certname=no
	record_admin=no
	if [ -n "$name" ]; then
		record_certname=yes
		if dropins_mention openvox-ca-first-boot.service OPENVOX_CA_CERTNAME; then
			record_certname=no
		fi
		record_admin=yes
		if [ -f "$CONFIG" ] &&
			grep -Eq "^[[:space:]]*['\"]?(puppet_server|puppet_server_file)['\"]?[[:space:]]*:" "$CONFIG" 2>/dev/null; then
			record_admin=no
		elif dropins_mention openvox-ca.service \
			OPENVOX_CA_PUPPET_SERVER OPENVOX_CA_PUPPET_SERVER_FILE OPENVOX_CA_CONFIG; then
			record_admin=no
		fi
	fi

	# Rendered whether or not there is anything to set, so ucf always owns the
	# file and a later answer arrives as an update rather than a new file.
	# mktemp's 0600 is the mode ucf creates it with, and it keeps an
	# operator's mode from then on.
	tmp=$(mktemp) || {
		warn "could not create a temporary file, so $DEFAULT_FILE was not updated."
		return 0
	}
	if {
		printf '%s\n' \
			"# Install-time values for openvox-ca, rendered by the package from debconf and" \
			"# kept by ucf: once you edit it, a change from the package asks you first, or" \
			"# unattended keeps yours and leaves its version as .ucf-dist; unedited, it is" \
			"# replaced. To change the name, run 'dpkg-reconfigure openvox-ca'." \
			"#" \
			"# These outrank /etc/openvox-ca/config.yaml and Environment= in any drop-in." \
			"# OPENVOX_CA_PUPPET_SERVER replaces puppet_server in config.yaml rather than" \
			"# adding to it, and takes effect on 'systemctl restart openvox-ca'." \
			"# OPENVOX_CA_CERTNAME takes effect only when the CA re-provisions: see the" \
			"# re-mint steps in the documentation below. Keep this file root-only (0600)" \
			"# if you add credentials to it." \
			"#" \
			"# See /usr/share/doc/openvox-ca/docs/systemd.md." &&
			if [ "$record_certname" = yes ]; then printf 'OPENVOX_CA_CERTNAME=%s\n' "$name"; fi &&
			if [ "$record_admin" = yes ]; then printf 'OPENVOX_CA_PUPPET_SERVER=%s\n' "$name"; fi
	} >"$tmp" && ucf --three-way --debconf-ok "$tmp" "$DEFAULT_FILE" && ucfr openvox-ca "$DEFAULT_FILE"; then
		:
	else
		warn "could not update $DEFAULT_FILE through ucf. The CA works without it, but" \
			"provisioning will choose the name itself and the node certificate will not be an" \
			"admin until puppet_server names it."
	fi
	rm -f "$tmp"
}

if [ "$debconf" = yes ]; then
	render_default_file
fi

# -- systemd -----------------------------------------------------------------

# On the rpm, openvox-ca.service is neither enabled nor started here: the
# operator gets a configuration file to review first, and an install is not
# consent to create a certificate authority. (The one exception is rpm's
# preset, at the foot of this file: a site preset that enables the unit is that
# consent, given in advance.) The deb follows Debian's convention instead and
# enables and starts it, in its own block at the foot of this file.
#
# openvox-ca-first-boot.service IS enabled, and that is not the same thing.
# Its [Install] section carries only RequiredBy=openvox-ca.service, so enabling
# it installs one symlink into openvox-ca.service.requires/ and nothing that
# any target pulls in. It therefore runs when openvox-ca first starts and at no
# other time -- which on the deb is this install's own start, and on the rpm is
# the operator's `enable --now` (or the next boot, where a site preset enables
# openvox-ca.service itself; see the preset at the foot of this file).
# Without this the [Install] section is inert, because systemd acts on
# [Install] at enable time and never merely because a unit file is present.
#
# daemon-reload needs a systemd that is actually running, so it stays behind
# the runtime check. `systemctl enable` does not: it writes a symlink into
# /etc/systemd/system, which is ordinary on-disk work that succeeds in a
# chroot, a debootstrap or mmdebstrap target, a container image build, or any
# install into a mounted root. Gating the enable on a *running* systemd meant
# none of those hosts ever got the symlink -- and because the oneshot's only
# [Install] directive is RequiredBy=, a unit that is never enabled is a unit
# that never runs. The first `systemctl start openvox-ca` on such a host then
# exits on the serving credential provisioning would have created, and nothing
# retries the enable on the next boot.
if [ -d "$SYSTEMD_RUNTIME" ]; then
	systemctl daemon-reload >/dev/null 2>&1 || :

	# And restart a RUNNING CA on an upgrade, so the new binary is the one
	# serving.
	#
	# Without this, `apt upgrade` replaces /usr/bin/openvox-ca and both units,
	# reports success, and leaves the old process running the superseded image
	# indefinitely -- with nothing in the package-manager output or the journal
	# to say a restart is outstanding. preremove deliberately does not stop the
	# service on an upgrade, which is right (an upgrade is not an outage), but
	# nothing was then picking the new binary up. For a service whose upgrades
	# carry certificate-handling fixes, an upgrade that silently does not take
	# effect is the wrong default.
	#
	# try-restart, not restart: it restarts the unit only if it is already
	# running, so an rpm install that deliberately left the CA stopped -- which
	# is every fresh rpm install, because this script never starts one there --
	# stays stopped. An install is not consent to create a certificate
	# authority on EL, and that has to remain true on the upgrade path too.
	#
	# Not on a first install: rpm passes 1, and there is nothing running to
	# restart. And not on the deb at all: Debian restarts through
	# deb-systemd-invoke, which honours policy-rc.d, at the foot of this file.
	if [ "${1:-}" = 2 ]; then
		systemctl try-restart openvox-ca.service >/dev/null 2>&1 || warn \
			"could not restart openvox-ca.service after the upgrade. If it is running it is still" \
			"executing the previous binary; run 'systemctl restart openvox-ca' when convenient."
	fi
fi

# Enabled once, by us, and not re-enabled afterwards -- an operator who runs
# `systemctl disable openvox-ca-first-boot` must not have that undone by the
# next package update.
#
# The marker, rather than dpkg's $2, is what distinguishes the two cases. dpkg
# passes the previously-configured version in $2 for a package that was removed
# but not purged as well as for a genuine upgrade, so a `remove` followed by an
# `install` looked like an upgrade -- and since our own preremove had disabled
# the unit, the reinstall left it disabled, giving a service that starts and
# exits. preremove deletes the marker on removal, so a reinstall enables again
# while an operator's deliberate disable survives an upgrade.
#
# The outcome is reported. It decides whether provisioning ever runs, and the
# previous version sent it to /dev/null: an install could "succeed" and leave a
# host whose first `systemctl start openvox-ca` bootstraps a CA inside the
# server process under a name none of first-boot's checks ever saw.
if [ ! -e "$ENABLED_MARKER" ]; then
	if systemctl enable openvox-ca-first-boot.service >/dev/null 2>&1; then
		# Reported, not swallowed, like every other step in this script. The
		# unit is enabled at this point whatever happens next, so a failure
		# here is not an install failure -- but it leaves no record that we
		# enabled it, and the marker is the only thing that stops the NEXT
		# upgrade enabling it again. An operator who has since run
		# `systemctl disable openvox-ca-first-boot` would have that decision
		# silently undone, which is the one outcome this marker exists to
		# prevent. Causes are mundane and real: a read-only /var during an
		# image build, a full filesystem, an SELinux denial, something already
		# occupying $STATEDIR.
		#
		# printf, not `:`. `:` is a POSIX special built-in, and a redirection
		# that fails on one exits a non-interactive shell outright -- on dash
		# and on bash as sh alike -- so the warning below never ran and the
		# postinstall failed instead, the outcome this block exists to avoid.
		if mkdir -p "$STATEDIR" 2>/dev/null && printf '' >"$ENABLED_MARKER" 2>/dev/null; then
			:
		else
			warn "enabled openvox-ca-first-boot.service but could not record it at" \
				"$ENABLED_MARKER. Provisioning is set up correctly and will run. The only" \
				"consequence is later: if you run 'systemctl disable openvox-ca-first-boot'," \
				"the next package upgrade will re-enable it. Create that file yourself to" \
				"make the disable stick."
		fi
	else
		warn "could not enable openvox-ca-first-boot.service. First-boot provisioning will not" \
			"run, and 'systemctl start openvox-ca' will bootstrap a CA under a name none of its" \
			"checks have seen. Run 'systemctl enable openvox-ca-first-boot' before starting the" \
			"service."
	fi
fi

# -- EL: presets, and what to do next ----------------------------------------

# rpm's first install only: `1` is the only argument that means it, because
# rpm passes 2 on an upgrade and dpkg never passes a number. nfpm emits this
# script verbatim, so %systemd_post -- which is what an rpm built from a spec
# file would run here -- is not available, and this is its equivalent by hand.
#
# A preset, not an enable. The distribution's default policy disables a
# third-party unit, which is the EL convention: `dnf install` installs and
# nothing else, and a CA key pair is created by an explicit act. A site or
# image whose own preset enables openvox-ca.service gets that, which is what
# presets are for. On-disk work like the enable above, so it is not behind the
# runtime check either. openvox-ca-first-boot.service is deliberately left out:
# under the default policy a preset would disable it, undoing the enable above,
# and then the first start would provision nothing.
if [ "${1:-}" = 1 ]; then
	systemctl preset openvox-ca.service >/dev/null 2>&1 || warn \
		"could not apply the systemd preset for openvox-ca.service. It is left as it was," \
		"which on a new install is disabled."

	# Since nothing has started, say what does. On stdout, because this is
	# not a warning: dnf shows a scriptlet's output either way. printf, a
	# builtin, rather than cat: under `set -e` a message that could fail would
	# fail the install, and a message is the last thing that should.
	printf '%s\n' \
		"openvox-ca is installed but not running. To create the CA and start it:" \
		"" \
		"    systemctl enable --now openvox-ca" \
		"" \
		"Review /etc/openvox-ca/config.yaml first if you want to; it works unedited." \
		"Documentation: /usr/share/doc/openvox-ca/docs/systemd.md" \
		"If the start fails: journalctl -u openvox-ca-first-boot" || :
fi

# -- Debian: enable and start ------------------------------------------------

# Debian's convention is that installing a daemon starts it (openvox-ca#251),
# and this is what dh_installsystemd would generate for that. Last, because
# starting the service pulls in the provisioning oneshot only once the enable
# above has given it its RequiredBy= link -- and because debconf has to be let
# go first: a daemon started while the confmodule holds its descriptors keeps
# them, and the package manager waits on it for ever.
#
# The enable is deb-systemd-helper's, not systemctl's: it records the state,
# so an operator's `systemctl disable openvox-ca` survives an upgrade (was-enabled
# then fails, and only the state is updated), while a first install, where
# nothing is recorded yet, enables. On-disk work, so not behind the runtime
# check.
#
# The start is deb-systemd-invoke's, which honours policy-rc.d: a chroot, a
# container or an image build that forbids starting daemons does not get a CA
# bootstrapped inside it, and the install still succeeds. `restart` on an
# upgrade, as dh_installsystemd does, so the new binary is the one serving; a
# disabled unit that is not running is left alone by it.
#
# Except on a takeover: a first install onto a host that already has a CA --
# in the default or configured CA directory, or in OpenVox Server 6+'s own --
# or that has OpenVox Server installed. Starting there could make this a
# second writer to a CA directory that is Server's, and live, and the
# filesystem backend permits exactly one (docs/systemd.md, "One instance per
# CA directory"). So the unit is neither started nor enabled, and the operator
# is told what to do first. Not enabled either, because an enabled unit starts
# at the next boot just the same; update-state records it as disabled, so a
# later upgrade does not enable it behind their back.
#
# "First install" is dpkg's empty $2, so an upgrade, or a reinstall after
# `apt remove`, finds this package's own CA and is not a takeover. A reinstall
# after a purge that kept the CA's data is: dpkg has forgotten the package, and
# nothing on disk says whose the CA is. Failing closed there costs the operator
# one `systemctl enable --now`, which the warning names.
existing_ca_dir() {
	for dir in "$SSLDIR/ca" "$SERVER_CADIR" "$(sed -n "s/^cadir:[[:space:]]*['\"]\{0,1\}\([^'\"#[:space:]]*\).*/\1/p" "$CONFIG" 2>/dev/null | tail -n 1)"; do
		if [ -n "$dir" ] && [ -e "$dir/ca_crt.pem" ]; then
			printf '%s\n' "$dir"
			return 0
		fi
	done
	return 1
}

# Installed, not only running: Server stopped for a backup is still Server.
# On-disk, so it works without a running systemd too.
server_installed() {
	for root in "$DROPIN_ROOT" "$SYSTEMD_RUNTIME" "$VENDOR_UNIT_ROOT" "$LEGACY_UNIT_ROOT"; do
		[ -e "$root/puppetserver.service" ] && return 0
	done
	return 1
}

if [ "${1:-}" = configure ]; then
	takeover=
	if [ -z "${2:-}" ]; then
		if dir=$(existing_ca_dir); then
			takeover="$dir already holds a CA from before this install"
		elif server_installed; then
			takeover="OpenVox Server (puppetserver.service) is installed"
		elif [ -d "$SYSTEMD_RUNTIME" ] && systemctl is-active --quiet puppetserver.service 2>/dev/null; then
			takeover="OpenVox Server (puppetserver.service) is running"
		fi
	fi

	if command -v deb-systemd-helper >/dev/null 2>&1; then
		deb-systemd-helper unmask openvox-ca.service >/dev/null 2>&1 || :
		if [ -z "$takeover" ] && deb-systemd-helper --quiet was-enabled openvox-ca.service; then
			deb-systemd-helper enable openvox-ca.service >/dev/null 2>&1 || warn \
				"could not enable openvox-ca.service; run 'systemctl enable openvox-ca'."
		else
			deb-systemd-helper update-state openvox-ca.service >/dev/null 2>&1 || :
		fi
	fi

	if [ "$debconf" = yes ]; then
		db_stop
	fi

	if [ -n "$takeover" ]; then
		warn "openvox-ca was installed but neither enabled nor started: $takeover." \
			"If OpenVox Server's CA is involved, disable it first, as" \
			"/usr/share/doc/openvox-ca/docs/migrating-from-puppet-server.md describes," \
			"or the two would both write to one CA directory. If this is a CA that an" \
			"earlier purge of openvox-ca kept, nothing else is needed. Then run" \
			"'systemctl enable --now openvox-ca'."
	elif [ -d "$SYSTEMD_RUNTIME" ]; then
		action=start
		[ -n "${2:-}" ] && action=restart
		# stderr left alone: it is where deb-systemd-invoke says policy-rc.d
		# declined the start, which is the answer to "why is it not running".
		{ command -v deb-systemd-invoke >/dev/null 2>&1 &&
			deb-systemd-invoke "$action" openvox-ca.service >/dev/null; } || warn \
			"could not $action openvox-ca.service. If provisioning failed, the reason is in" \
			"'journalctl -u openvox-ca-first-boot'; fix it and run 'systemctl restart" \
			"openvox-ca-first-boot openvox-ca'."
	fi
fi
