#!/bin/sh
#
# Shared preremove for the deb and the rpm: stop and disable the units while
# they are still on disk to be found.
#
# Removal only. Both package managers run this on upgrade as well, with an
# argument that says so -- dpkg passes "upgrade", rpm passes a remaining-count
# of 1 -- and stopping the service on an upgrade would be a needless outage.

set -eu

case "${1:-}" in
0 | remove | purge) ;;
*) exit 0 ;;
esac

if [ -d /run/systemd/system ]; then
	systemctl --no-reload disable --now openvox-ca.service >/dev/null 2>&1 || :
	systemctl --no-reload disable openvox-ca-first-boot.service >/dev/null 2>&1 || :
fi
