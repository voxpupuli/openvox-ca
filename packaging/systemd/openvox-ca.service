# One unit, rendered per channel: ExecStart below carries a placeholder in the
# copy kept in the repository, and rendering substitutes it. The release
# tarballs get /usr/local/bin, which is what an unmanaged `install` prefix
# means; the deb and rpm get /usr/bin, which is what a package must use.
# `mage build:unit <bindir>` renders a copy locally -- see docs/systemd.md.
#
# This comment travels into both rendered copies, so ExecStart is what tells
# you which one you are reading: an absolute path means an installable unit, a
# placeholder means the template and not something to install.
#
# The placeholder is deliberately not spelled out in prose here, because
# rendering replaces every occurrence of it in the file -- naming it would have
# this comment rewritten too, and the shipped unit would then explain itself
# with the substitution already applied.

[Unit]
Description=OpenVox Certificate Authority
Documentation=https://github.com/voxpupuli/openvox-ca/blob/main/docs/systemd.md
After=network-online.target
Wants=network-online.target

[Service]
# openvox-ca reports READY=1 once its listener is accepting connections, so
# anything ordered after this unit starts against a CA that is genuinely
# serving rather than one that has merely been forked.
Type=notify

# Readiness is reported by the frontend child process, not the launcher: only
# the frontend knows when the socket is up. The launcher is the main PID, so
# the default (NotifyAccess=main) would drop those notifications and the start
# job would time out.
NotifyAccess=all

# SIGHUP re-reads the TLS keypair and the admin allow list. On systemd 253 and
# later you can drop this line and set Type=notify-reload instead, which makes
# "systemctl reload" wait for the new configuration to be in effect.
ExecReload=/bin/kill -HUP $MAINPID

# No --config: the binary already auto-detects /etc/openvox-ca/config.yaml when
# it exists, and pinning the path here would make OPENVOX_CA_CONFIG inert and
# turn an env-only deployment (no YAML on disk) into a start failure.
ExecStart=@BINDIR@/openvox-ca

# The frontend feeds the watchdog on a timer, so a frontend that has died or
# whose heartbeat has stalled is restarted rather than left half-alive. It is
# not a backend health check -- see docs/systemd.md for what it does and does
# not catch.
#
# 90s, not 60s: composing the status text takes the CA's read lock, and a
# storage operation holding the write lock is bounded by a 60s cluster-lock
# timeout. An equal budget would leave no headroom between "slow backend" and
# "kill the service".
WatchdogSec=90s
Restart=on-failure
RestartSec=5s

# Bootstrapping a CA generates a key pair, which can take a while on a slow or
# entropy-starved machine; the status text says what it is waiting on. Before
# that, Init may spend two internal/ca LockTimeout budgets in sequence waiting
# on another replica — hmac-key on a cold start, then bootstrap — so this must
# clear those with room for the key generation on top. A CA using
# serving_cert spends up to one further LockTimeout issuing its own serving
# certificate before the listener binds, so the lock-wait term is three rather
# than two -- plus the store read that follows the pass, which is outside its
# budget by design.
#
# Worst case, quantified rather than left open, because an operator installing
# this file is entitled to know whether it covers them:
#
#   Init, hmac-key on a cold start        60s   (LockTimeout)
#   Init, bootstrap                       60s   (LockTimeout)
#   serving_cert's pre-bind reconcile     60s   (LockTimeout)
#   the store read that decides startup   30s   (certstore's Secret API
#                                               timeout; a file store is
#                                               effectively instant)
#   ----------------------------------------
#   bounded total                        210s
#
# leaving 90s of the 300s for key generation, which is the one term with no
# bound of its own. That headroom was 180s before serving_cert existed, so the
# feature halves it.
#
# Note which key that is. ca_key_algo defaults to RSA and ca_key_size to 4096,
# so generating a 4096-bit key inside that 90s is the DEFAULT path, not an
# exotic one -- on an entropy-starved host it is the term most likely to trip
# TimeoutStartSec, and the first figure to raise. An earlier revision of this
# comment called RSA-4096 the edge case and named RSA-2048 as a default; both
# were wrong, and the mistake made the normal configuration sound like the
# safe one.
#
# Every lock term assumes an actual contending replica; a single-instance start
# spends none of them and reaches the listener in milliseconds.
#
# cmd/openvox-ca/launcher_test.go asserts that floor. charts/openvox-ca does
# NOT give Init the same budget: its startupProbe allows failureThreshold 30 x
# periodSeconds 2 = 60s, which does not cover even the 210s of bounded terms
# above. That is deliberate and documented in the chart's own values.yaml,
# which tells an operator to raise failureThreshold when self-provisioning
# against a remote key provider or a slow store -- but it is 60s, not 300s,
# and an earlier revision of this line said otherwise.
TimeoutStartSec=300s

# Values provisioning recorded on EL: the certificate name and the admin
# allow-list (OPENVOX_CA_PUPPET_SERVER), which outranks puppet_server in
# /etc/openvox-ca/config.yaml -- and, because systemd lets EnvironmentFile=
# outrank Environment=, the same variable set with Environment= in any drop-in
# (a drop-in's own EnvironmentFile= is read after this one and wins). Written
# once per host by openvox-ca-first-boot.service's record-environment step,
# which leaves out a variable a drop-in's Environment= already sets, and never
# by the package, so it is the
# operator's from then on. The leading `-` is what lets a host without it
# start: one that was never provisioned, a Debian host, a tarball install, or
# one whose operator deleted it to hand those values back to the
# configuration file.
EnvironmentFile=-/etc/sysconfig/openvox-ca

# Must exceed the drain budget (shutdown_timeout_sec, 25s by default) plus the
# supervisor's 3s headroom, or systemd will truncate the drain it asked for.
TimeoutStopSec=35s

# `puppet`, not a private `puppet-ca`: OpenVox Server already creates
# puppet:puppet and chowns /etc/puppetlabs/puppet/ssl to it, so the tree this
# service writes is already expected to be owned by that account. See
# docs/systemd.md. The account is not assumed to exist -- the packages create
# it themselves, because this host may run neither openvox-agent nor
# openvox-server.
User=puppet
Group=puppet

# The only writable path under ProtectSystem=strict below, and it is the CA
# directory alone. A filesystem-backend CA writes a signed certificate, a
# serial and a CRL under here, so without this the service cannot issue.
#
# Deliberately narrower than openvox-ca-first-boot.service, which gets the
# parent /etc/puppetlabs/puppet/ssl because it links certs/ca.pem and crl.pem
# into the tree above this one. The long-running service never needs to write
# there, so it does not get to.
#
# Point cadir somewhere else and the new directory has to be writable too --
# granted with a drop-in (`systemctl edit openvox-ca`, then [Service] and
# ReadWritePaths=<cadir>), not by editing this line. A packaged install replaces
# this file on every upgrade, and the edit would go with it. ReadWritePaths= in
# a drop-in adds to this one rather than replacing it.
#
# Two more writers outside cadir need the same drop-in. A managed certificate
# with a `files` store writes outside cadir by definition; see "managed
# certificates" in docs/configuration.md. The CA's own serving certificate --
# `serving_cert` -- always does too, because its `files` store must sit
# outside cadir, which the CA reserves against every file store, and cadir is
# the only path this unit makes writable. The difference is the consequence:
# a managed certificate that cannot be written is logged and retried on the
# next pass, but the serving certificate is what the listener presents, so an
# unwritable store is fatal and the CA refuses to start.
#
# A cadir OpenVox Server may take back needs this unit to run as OpenVox
# Server's user, which User=puppet above already does; see "Sharing the cadir
# with OpenVox Server" in docs/storage-backends.md.
ReadWritePaths=/etc/puppetlabs/puppet/ssl/ca

# Hardening. The CA holds a private key that signs every certificate in the
# estate, so it should reach as little of the system as possible.
#
# The signer holds the decrypted CA private key in memory for its whole life,
# so a core dump would write that key to /var/lib/systemd/coredump -- defeating
# encryption at rest. Go re-raises fatal signals with the default handler, so
# this is reachable from an ordinary crash or a SIGQUIT taken for a stack dump.
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
# Left off, because hiding the system-wide part of /proc costs two things.
# Without /proc/sys/net/core/somaxconn, Go gives every listener a backlog of
# 128 rather than the host's setting (4096 by default). And the exporter's
# process_start_time_seconds needs the boot time from /proc/stat, so that
# series disappears without an error.
#ProcSubset=pid
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# No mapping may be writable and executable, at once or one after the other.
# Go needs none: it has no JIT, and its binaries carry a non-executable stack
# -- the FIPS build, which links glibc and BoringCrypto, included.
MemoryDenyWriteExecute=yes
# Group and world bits are masked from the mode anything is created with.
# Most files openvox-ca writes get their mode set after creation, where a
# umask does not reach, so what this narrows today is the directories it
# creates under the CA directory, 0750 to 0700, and an SQLite store and its
# sidecars, 0640 under systemd's default umask to 0600 -- group access that
# this account, whose uid does not change between starts, has no use for. The CA directory itself exists
# before the service starts and keeps its mode. This is here for the code
# path that creates something wider than it should.
UMask=0077
# RemoveIPC= is deliberately absent, and must stay absent.
#
# It removes every System V and POSIX IPC object owned by the unit's UID when
# the unit stops -- the UID, not this unit's processes. That was harmless while
# the service ran as a private `puppet-ca` account. It is not once the account
# is `puppet`, which is shared with openvox-agent and openvox-server by design
# (see above), because a co-located CA and Server is exactly the deployment
# that sharing exists for.
#
# It is dropped rather than justified, because it protects nothing here.
# openvox-ca creates no System V or POSIX IPC object at all: its only IPC is
# the AF_UNIX socketpair the launcher passes to the isolated signer on fd 3
# (internal/signer/signer.go), which RemoveIPC= does not cover and which the
# kernel reclaims when the last descriptor closes. So the directive had no
# cleanup to do for this service, and the only thing it could ever have acted
# on belongs to somebody else.
#
# Note what this reasoning does NOT rest on: any claim about whether
# openvox-server holds SysV IPC under that UID. That is another product's
# internals, it can change without us, and a hardening directive should not
# need it to be true.
# AF_UNIX covers both the notification socket and the launcher's socketpair to
# the isolated signer process.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# The API and the metrics exporter both listen on unprivileged ports -- the
# binary defaults to 8140 and 9140, the packages ship a configuration file
# that moves the API off 8140 to leave it to OpenVox Server, and any port an
# operator configures instead is unprivileged too or the service could not bind
# it. So the service needs no capabilities at all. (The number itself is
# deliberately not repeated here: it is set in one place, the packaged
# /etc/openvox-ca/config.yaml, and a unit shared with the release tarballs is
# not that place.)
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
