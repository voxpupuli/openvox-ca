# ---- Build Stage ----
FROM golang:1.27.4@sha256:08bcb99a38f85a265f9a93d1d3323e2440eec333380f3ea26ee0dec9264bb41c AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
ENV CGO_ENABLED=0 GOOS=linux
# -trimpath, as the release tarballs are built (buildDistVariant in
# magefile.go): it keeps the builder's paths -- /src, and the toolchain's own
# location, which differs between the images -- out of the binaries.
RUN go build -trimpath -ldflags="-s -w" -o /openvox-ca     ./cmd/openvox-ca/ && \
    go build -trimpath -ldflags="-s -w" -o /openvox-ca-ctl ./cmd/openvox-ca-ctl/

# The default configuration, staged with its mode for the runtime stage's COPY.
RUN install -D -m 0644 packaging/container/config.yaml /container-config/config.yaml

# ---- Runtime Stage ----
FROM alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf

# ca-certificates: system trust store for openvox-ca-ctl's HTTPS client
# when invoked without --ca-cert against a publicly-trusted server.
#
# The puppet uid/gid is pinned rather than left to adduser's first-free
# allocation: `USER` below has to be numeric so a host that cannot read the
# image's /etc/passwd -- Kubernetes checking `runAsNonRoot`, or an operator
# matching ownership on a bind mount -- can still tell who the process runs as.
# 65532 is the distroless image's nonroot uid, so the two images, and the Helm
# chart's podSecurityContext, all run the CA as the same user and can take over
# each other's data.
# Both assertions below must be re-verified by hand when edited -- CI only ever
# takes their passing branch. See docs/development/testing.md, "Container
# identity guards", for the mutations and the messages they should produce.
RUN apk add --no-cache ca-certificates && \
    addgroup -g 65532 puppet && \
    adduser -D -u 65532 -G puppet -h /home/puppet puppet && \
    { [ "$(id -u puppet):$(id -g puppet)" = "65532:65532" ] || \
        { echo "puppet is $(id -u puppet):$(id -g puppet), not 65532:65532; USER below must match" >&2; exit 1; }; } && \
    mkdir -p /etc/puppetlabs/puppet/ssl/ca /data && \
    chown -R puppet:puppet /etc/puppetlabs/puppet /data && \
    for d in /etc/puppetlabs/puppet/ssl/ca /data; do \
        [ "$(stat -c %u:%g "$d")" = "65532:65532" ] || \
            { echo "$d is owned by $(stat -c %u:%g "$d"), not 65532:65532; the CA could not write there" >&2; exit 1; }; \
    done

COPY --from=builder /openvox-ca     /usr/local/bin/openvox-ca
COPY --from=builder /openvox-ca-ctl /usr/local/bin/openvox-ca-ctl

# The configuration the default CMD below runs with: it has the CA issue its own
# serving certificate, so a bare `docker run` starts and serves TLS that agents
# can verify, without the CA key on the network-facing listener. Root-owned and
# read-only to the CA; replace it by mounting another file over it, or with
# OPENVOX_CA_CONFIG or --config. See packaging/container/config.yaml. Staged
# in the builder rather than copied with --chmod, which BuildKit applies to the
# directory it creates as well, leaving /etc/openvox-ca untraversable.
COPY --from=builder /container-config/ /etc/openvox-ca/

USER 65532:65532
EXPOSE 8140

# The image's own health state, for `docker ps` and Docker Compose. Podman
# does not read it from an OCI-format image, which is what CI publishes, so
# compose.yml declares the same check and the docs give Podman users the
# --health-cmd that matches it. It is a subcommand of the server binary rather than curl or wget so the same line
# works in every image, including one with no shell. It requests
# /healthz/ready, over HTTPS or plain HTTP as the server speaks, on the port
# from the server's config file and OPENVOX_CA_* environment; a port set only
# with --port on the server's command line (CMD below, or `docker run`) needs
# this line overridden. See docs/container-images.md#health-check.
# --start-period is generous because the first start generates the CA key; a
# check that passes ends it early.
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD ["/usr/local/bin/openvox-ca", "healthcheck"]

# NOTE: autosign is OFF by default. Set --autosign-config=true only in
# dev/test environments. Autosign lets any CSR submitter obtain a signed
# certificate without operator review.
ENTRYPOINT ["/usr/local/bin/openvox-ca"]
CMD ["--cadir=/etc/puppetlabs/puppet/ssl/ca", \
     "--verbosity=1"]
